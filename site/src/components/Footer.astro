---
import { withBase } from "../lib/url";

interface Props {
  // "home" shows a Docs link; "docs" swaps in Edit-this-page + Home links,
  // matching the two footers of the original static site.
  variant?: "home" | "docs";
}
const { variant = "home" } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <span>Cartog · <a href="https://github.com/jrollin/cartog/blob/main/LICENSE">MIT License</a> · <a href="https://github.com/jrollin/cartog/releases">Latest release</a></span>
      <ul class="footer-links">
        <li><a href="https://github.com/jrollin/cartog">GitHub</a></li>
        <li><a href="https://crates.io/crates/cartog">crates.io</a></li>
        {variant === "docs" ? (
          <>
            <li><a href="https://github.com/jrollin/cartog/blob/main/site/src/pages/usage.astro">Edit this page</a></li>
            <li><a href={withBase("index.html")}>Home</a></li>
          </>
        ) : (
          <li><a href={withBase("usage.html")}>Docs</a></li>
        )}
      </ul>
    </div>
  </div>
</footer>
