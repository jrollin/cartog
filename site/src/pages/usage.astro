  <script is:inline>
    (function () {
      var OFFSET = 90; // sticky-nav height + breathing room

      // Left-nav links keyed by their target id, for active highlighting.
      var navLinks = {};
      document.querySelectorAll(".docs-sidebar a").forEach(function (a) {
        navLinks[a.getAttribute("href").slice(1)] = a;
      });

      // Build the section model: each h2 owns the h3s that follow it until the
      // next h2. Drives the right "On this page" rail. h3s often ship without
      // an id, so derive a stable slug so the rail can anchor + scroll-spy them.
      var content = document.querySelector(".docs-content");
      var headings = Array.prototype.slice.call(content.querySelectorAll("h2, h3"));

      function slugify(text) {
        return text
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      var sections = [];
      var current = null;
      headings.forEach(function (h) {
        if (!h.id) {
          var base = slugify(h.textContent || "") || "section";
          var id = base, n = 2;
          while (document.getElementById(id)) id = base + "-" + n++;
          h.id = id;
        }
        if (h.tagName === "H2") {
          current = { id: h.id, el: h, subs: [] };
          sections.push(current);
        } else if (current) {
          current.subs.push({ id: h.id, el: h });
        }
      });

      var tocNav = document.querySelector(".docs-toc-nav");
      var tocAside = document.querySelector(".docs-toc");
      var renderedSection = null;

      // Render the right rail for a given section's sub-headings.
      function renderToc(section) {
        if (renderedSection === section) return;
        renderedSection = section;
        tocNav.innerHTML = "";
        if (!section || !section.subs.length) {
          tocAside.classList.add("is-empty");
          return;
        }
        tocAside.classList.remove("is-empty");
        section.subs.forEach(function (s) {
          var a = document.createElement("a");
          a.href = "#" + s.id;
          a.textContent = (s.el.textContent || "").trim();
          a.dataset.id = s.id;
          tocNav.appendChild(a);
        });
      }

      function openGroupOf(link) {
        var group = link && link.closest(".sidebar-group");
        if (group && !group.open) group.open = true;
      }

      function update() {
        var y = window.scrollY + OFFSET;

        // Active h2 section = last one whose top is above the scroll line.
        var activeSection = sections.length ? sections[0] : null;
        sections.forEach(function (s) {
          if (s.el.offsetTop <= y) activeSection = s;
        });

        // Active sub-heading within that section.
        var activeSub = null;
        if (activeSection) {
          activeSection.subs.forEach(function (s) {
            if (s.el.offsetTop <= y) activeSub = s;
          });
        }

        // Left nav: highlight the active link (sub if present, else section)
        // and auto-open its group.
        var activeId = (activeSub && activeSub.id) || (activeSection && activeSection.id);
        Object.keys(navLinks).forEach(function (id) {
          navLinks[id].classList.toggle("active", id === activeId);
        });
        if (activeId && navLinks[activeId]) openGroupOf(navLinks[activeId]);

        // Right rail: show the active section's subs, highlight current.
        renderToc(activeSection);
        if (renderedSection) {
          tocNav.querySelectorAll("a").forEach(function (a) {
            a.classList.toggle("active", activeSub && a.dataset.id === activeSub.id);
          });
        }
      }

      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    })();
  </script>
