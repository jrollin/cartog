{
  "01_find_callers": {
    "description": "Who calls validate_token?",
    "query": "refs validate_token --kind calls",
    "expected": [
      {
        "source": "auth_middleware_handle",
        "file": "middleware/auth_middleware.c"
      },
      {
        "source": "get_current_user",
        "file": "auth/auth_service.c"
      },
      {
        "source": "refresh_token",
        "file": "auth/token_service.c"
      }
    ]
  },
  "02_file_structure": {
    "description": "What's in auth/token_service.c?",
    "query": "outline auth/token_service.c",
    "expected": [
      {
        "name": "token_service_new",
        "kind": "function"
      },
      {
        "name": "generate_token",
        "kind": "function"
      },
      {
        "name": "validate_token",
        "kind": "function"
      },
      {
        "name": "refresh_token",
        "kind": "function"
      },
      {
        "name": "revoke_token",
        "kind": "function"
      }
    ]
  },
  "03_refactor_impact": {
    "description": "Impact of changing AuthService (C: transitive references through struct members and function-pointer vtables)",
    "query": "impact AuthService --depth 3",
    "expected_refs": [
      "AdminService",
      "AuthenticationService",
      "RoleChecker",
      "auth/auth_service.h",
      "auth/auth_service.c",
      "services/authentication_service.h",
      "services/admin_service.h",
      "routes/auth_routes.c",
      "login_handler"
    ]
  },
  "04_class_hierarchy": {
    "description": "C has no inheritance (struct embedding + function-pointer vtable), so this scenario is skipped for webapp_c; cartog's hierarchy() returns nothing for BaseService",
    "query": "hierarchy BaseService",
    "expected": []
  },
  "05_trace_call_chain": {
    "description": "Trace handle_login call chain",
    "query_sequence": [
      "callees handle_login",
      "callees login",
      "callees generate_token"
    ],
    "expected_chain": [
      {
        "caller": "handle_login",
        "callee": "user_validator_validate"
      },
      {
        "caller": "handle_login",
        "callee": "login_handler"
      },
      {
        "caller": "login",
        "callee": "generate_token"
      },
      {
        "caller": "login",
        "callee": "authentication_error_new"
      },
      {
        "caller": "generate_token",
        "callee": "execute_query"
      },
      {
        "caller": "generate_token",
        "callee": "logger_debug"
      }
    ]
  },
  "06_file_deps": {
    "description": "What does routes/auth_routes.c include?",
    "query": "deps routes/auth_routes.c",
    "expected": [
      "auth_routes.h",
      "database_connection.h",
      "authentication_service.h",
      "logger.h"
    ]
  },
  "07_type_references": {
    "description": "Type references to TokenError (C has no inheritance/exceptions, so TokenError is referenced only via signatures and constructors)",
    "query": "refs TokenError",
    "expected": [
      {
        "source": "ExpiredTokenError",
        "file": "errors/errors.h",
        "kind": "references"
      },
      {
        "source": "token_error_new",
        "file": "errors/errors.c",
        "kind": "references"
      }
    ]
  },
