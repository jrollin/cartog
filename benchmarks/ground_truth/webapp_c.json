      }
    ]
  },
  "11_deep_call_chain": {
    "description": "Deep call chain from handle_login (6 hops)",
    "query_sequence": [
      "callees handle_login",
      "callees authenticate",
      "callees login",
      "callees generate_token",
      "callees execute_query",
      "callees get_connection"
    ],
    "expected_chain": [
      {
        "caller": "handle_login",
        "callee": "user_validator_validate"
      },
      {
        "caller": "handle_login",
        "callee": "login_handler"
      },
      {
        "caller": "authenticate",
        "callee": "require_initialized"
      },
      {
        "caller": "authenticate",
        "callee": "login"
      },
      {
        "caller": "authenticate",
        "callee": "insert"
      },
      {
        "caller": "login",
        "callee": "generate_token"
      },
      {
        "caller": "generate_token",
        "callee": "execute_query"
      },
      {
        "caller": "execute_query",
        "callee": "get_connection"
      },
      {
        "caller": "execute_query",
        "callee": "release_connection"
      },
      {
        "caller": "get_connection",
        "callee": "logger_debug"
      }
    ]
  },
