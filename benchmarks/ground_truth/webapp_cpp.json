      }
    ]
  },
  "10_high_fanout": {
    "description": "What inherits from AppException?",
    "query": "refs AppException",
    "expected": [
      {
        "name": "ValidationError",
        "file": "errors/exceptions.h"
      },
      {
        "name": "AuthenticationError",
        "file": "errors/exceptions.h"
      },
      {
        "name": "TokenError",
        "file": "errors/exceptions.h"
      }
    ]
  },
  "11_deep_call_chain": {
    "description": "Deep call chain from handle_login (6 hops)",
    "query_sequence": [
      "callees handle_login",
      "callees authenticate",
      "callees login",
      "callees generate_token",
      "callees execute_query",
      "callees get_connection"
    ],
    "expected_chain": [
      {
        "caller": "handle_login",
        "callee": "validator_.validate"
      },
      {
        "caller": "handle_login",
        "callee": "routes_.login_handler"
      },
      {
        "caller": "authenticate",
        "callee": "token_service_.validate_token"
      },
      {
        "caller": "authenticate",
        "callee": "require_initialized"
      },
      {
        "caller": "authenticate",
        "callee": "auth_service_.login"
      },
      {
        "caller": "authenticate",
        "callee": "db_.insert"
      },
      {
        "caller": "login",
        "callee": "token_service_.generate_token"
      },
      {
        "caller": "generate_token",
        "callee": "db_.execute_query"
      },
      {
        "caller": "execute_query",
        "callee": "pool_.get_connection"
      },
      {
        "caller": "execute_query",
        "callee": "pool_.release_connection"
      },
      {
        "caller": "get_connection",
        "callee": "handle.mark_used"
      }
    ]
  },
